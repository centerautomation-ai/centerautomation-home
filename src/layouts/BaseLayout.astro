---
import { Font } from 'astro:assets';
import Seo from '../components/Seo.astro';
import Logo from '../components/Logo.astro';
import { SITE, CTA, NAV } from '../consts';
import '../styles/global.css';

type Props = Parameters<typeof Seo>[0];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<Seo {...Astro.props} />

		<Font cssVariable="--font-inter" preload />

		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content={SITE.themeColor} />
	</head>
	<body class="flex min-h-screen flex-col">
		<a
			href="#main"
			class="sr-only z-50 rounded bg-ink px-4 py-2 text-paper focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
		>
			Skip to content
		</a>

		<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur">
			<div class="container-page flex h-16 items-center justify-between gap-6">
				<a href="/" class="inline-flex items-center gap-2.5 font-semibold" aria-label={`${SITE.name} home`}>
					<Logo size={30} title="" />
					<span>{SITE.name}</span>
				</a>

				<nav aria-label="Primary" class="hidden items-center gap-8 text-sm text-muted md:flex">
					{NAV.map((item) => <a href={`/${item.href}`} class="hover:text-ink">{item.label}</a>)}
				</nav>

				<div class="flex items-center gap-2">
					<a href={CTA.href} target={CTA.external ? "_blank" : undefined} rel={CTA.external ? "noopener" : undefined} class="btn-primary hidden py-2.5 sm:inline-flex">{CTA.label}</a>

					<details class="group relative md:hidden">
						<summary
							class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-line [&::-webkit-details-marker]:hidden"
							aria-label="Menu"
						>
							<svg viewBox="0 0 24 24" class="size-5 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
							<svg viewBox="0 0 24 24" class="hidden size-5 group-open:block" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
						</summary>
						<nav
							aria-label="Mobile"
							class="absolute right-0 mt-2 flex w-56 flex-col rounded-2xl border border-line bg-paper p-2 shadow-lg"
						>
							{NAV.map((item) => <a href={`/${item.href}`} class="rounded-lg px-3 py-2.5 hover:bg-mist">{item.label}</a>)}
							<a href={CTA.href} target={CTA.external ? "_blank" : undefined} rel={CTA.external ? "noopener" : undefined} class="btn-primary mt-2">{CTA.label}</a>
						</nav>
					</details>
				</div>
			</div>
		</header>

		<main id="main" class="flex-1">
			<slot />
		</main>

		<footer class="border-t border-line bg-mist">
			<div class="container-page grid gap-10 py-12 sm:grid-cols-[2fr_1fr_1fr]">
				<div>
					<a href="/" class="inline-flex items-center gap-2.5 font-semibold">
						<Logo size={28} title="" />
						<span>{SITE.name}</span>
					</a>
					<p class="mt-3 max-w-sm text-sm text-muted">
						AI-powered automation for teams that would rather do the work that matters.
					</p>
				</div>
				<div>
					<h2 class="text-sm font-semibold">Explore</h2>
					<ul class="mt-3 space-y-2 text-sm text-muted">
						{NAV.map((item) => <li><a href={`/${item.href}`} class="hover:text-ink">{item.label}</a></li>)}
					</ul>
				</div>
				<div>
					<h2 class="text-sm font-semibold">Contact</h2>
					<ul class="mt-3 space-y-2 text-sm text-muted">
						<li><a href={`mailto:${SITE.email}`} class="hover:text-ink">{SITE.email}</a></li>
						<li><a href={CTA.href} target={CTA.external ? "_blank" : undefined} rel={CTA.external ? "noopener" : undefined} class="hover:text-ink">{CTA.label}</a></li>
					</ul>
				</div>
			</div>
			<div class="container-page border-t border-line py-6 text-sm text-muted">
				<p>&copy; {year} {SITE.name}. All rights reserved.</p>
			</div>
		</footer>
	</body>
</html>
