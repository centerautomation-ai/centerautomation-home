---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
	<section class="container-page py-24 sm:py-32">
		<p class="eyebrow">404</p>
		<h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">This page took the day off.</h1>
		<p class="mt-4 text-lg text-muted">The page you’re looking for doesn’t exist or has moved.</p>
		<a href="/" class="btn-primary mt-8">Back to home</a>
	</section>
</BaseLayout>
