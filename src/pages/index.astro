---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout>
	<section class="mx-auto max-w-3xl px-4 py-16 sm:px-8 sm:py-24 lg:py-32" aria-labelledby="hero-title">
		<h1 id="hero-title" class="mb-4 text-4xl leading-tight font-bold tracking-tight sm:text-5xl lg:text-6xl">
			{SITE.name}
		</h1>
		<p class="text-lg text-muted">{SITE.description}</p>
	</section>
</BaseLayout>
